{
  "name": "understandproof",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @understandproof/web --filter @understandproof/worker --filter @understandproof/github-control dev",
    "dev:web": "pnpm --filter @understandproof/web dev",
    "dev:worker": "pnpm --filter @understandproof/worker dev",
    "dev:keys": "node scripts/generate-dev-keys.mjs",
    "prepare:landing": "node scripts/prepare-landing.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:seed": "tsx scripts/seed-demo.ts",
    "production:env": "tsx scripts/compile-production-env.ts",
    "smoke:r2-browser": "node --import tsx scripts/live-smoke-r2-browser.ts",
    "smoke:openrouter-semantic": "node --import tsx scripts/live-smoke-openrouter-mimo-semantic.ts",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:live-smoke-contracts": "node --test scripts/lib/live-smoke.test.mjs",
    "test:r2-browser-smoke-contracts": "node --test scripts/lib/r2-browser-smoke.test.mjs scripts/lib/r2-production-contract.test.mjs",
    "test:production-compose": "node --test scripts/lib/production-compose.test.mjs",
    "test:production-image": "node --test scripts/lib/production-image.test.mjs",
    "test:production-operations": "node --test scripts/lib/production-operations.test.mjs",
    "test:production-deployment": "node --test scripts/lib/production-deployment.test.mjs",
    "test:production-backup": "node --test scripts/lib/production-backup-workflow.test.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:storage:prepare": "node scripts/prepare-test-storage.mjs",
    "test:e2e": "playwright test",
    "audit:boundaries": "node scripts/audit-boundaries.mjs",
    "audit:doc-links": "node scripts/audit-doc-links.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "audit:history-secrets": "node scripts/audit-history-secrets.mjs",
    "test:release-audits": "node --test scripts/lib/history-secret-policy.test.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:release-audits && pnpm test:live-smoke-contracts && pnpm test:r2-browser-smoke-contracts && pnpm test:production-compose && pnpm test:production-image && pnpm test:production-operations && pnpm test:production-deployment && pnpm test:production-backup && pnpm build && pnpm audit:boundaries && pnpm audit:doc-links && pnpm audit:secrets && pnpm audit:history-secrets",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1108.0",
    "@playwright/test": "1.62.1",
    "@understandproof/auth": "workspace:*",
    "@understandproof/analysis": "workspace:*",
    "@understandproof/config": "workspace:*",
    "@understandproof/db": "workspace:*",
    "@understandproof/github": "workspace:*",
    "@understandproof/policy": "workspace:*",
    "@understandproof/providers": "workspace:*",
    "@understandproof/questions": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "testcontainers": "12.1.0",
    "tsx": "4.23.12",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "tsup>esbuild": "0.28.2",
      "vite>esbuild": "0.28.2"
    }
  }
}
